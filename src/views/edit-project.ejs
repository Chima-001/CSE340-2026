<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <%
    const d = new Date(project.project_date);
    const dateValue = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  %>

  <form action="/edit-project/<%= project.project_id %>" method="POST" class="form-card">
    <div class="form-group">
      <label for="title">Project Title</label>
      <input type="text" id="title" name="title" maxlength="150" value="<%= project.title %>" required />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" maxlength="500" required><%= project.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input type="text" id="location" name="location" maxlength="255" value="<%= project.location %>" required />
    </div>

    <div class="form-group">
      <label for="date">Date</label>
      <input type="date" id="date" name="date" value="<%= dateValue %>" required />
    </div>

    <div class="form-group">
      <label for="organizationId">Organization</label>
      <select id="organizationId" name="organizationId" required>
        <% organizations.forEach(org => { %>
          <option value="<%= org.organization_id %>" <%= Number(org.organization_id) === Number(project.organization_id) ? 'selected' : '' %>>
            <%= org.name %>
          </option>
        <% }); %>
      </select>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/project/<%= project.project_id %>" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</main>

<%- include('partials/footer') %>