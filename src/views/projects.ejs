<%- include('partials/header') %>

<main>
  <div class="container">
    <div class="section-header">
      <h2><%= title %></h2>
      <p>
        Explore upcoming service projects and find the right opportunity for you.
      </p>
    </div>
    <ul>
      <% projects.forEach(project => { %>
        <li class="card">
          <h3>
            <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>:
            <a href="/project/<%= project.project_id %>"><%= project.title %></a>
          </h3>
          <p>
            Organization:
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
          </p>
          <p><%= project.description %></p>
          <p>Location: <%= project.location %></p>
        </li>
      <% }); %>
    </ul>
  </div>
</main>

<%- include('partials/footer') %>