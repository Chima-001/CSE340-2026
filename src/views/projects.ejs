<%- include('partials/header') %>

<main>
  <div class="section-header">
    <h2><%= title %></h2>
    <p>
      Explore upcoming service projects and find the right opportunity for you.
    </p>
  </div>
  <ul>
    <% projects.forEach(project => { %>
      <li class="card">
        <h3>
          <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>:
          <%= project.title %> (<%= project.organization_name %>)
        </h3>
        <p><%= project.description %></p>
        <p>Location: <%= project.location %></p>
      </li>
    <% }); %>
  </ul>
</main>

<%- include('partials/footer') %>