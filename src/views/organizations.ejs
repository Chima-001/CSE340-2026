<%- include('partials/header') %>

<main>
  <div class="container">
    <div class="section-header">
      <h2><%= title %></h2>
      <p>Here are a few of our partner organizations:</p>
    </div>

    <div class="page-actions text-center">
      <a href="/new-organization" class="btn btn-primary">Add New Organization</a>
    </div>

    <ul>
      <% organizations.forEach(organization => { %>
        <li class="card">
          <img
            src="/images/<%= organization.logo_filename %>"
            alt="<%= organization.name %> logo"
          />
          <a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a>
          <p><%= organization.contact_email %></p>
        </li>
      <% }); %>
    </ul>
  </div>
</main>

<%- include('partials/footer') %>