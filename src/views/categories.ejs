<%- include('partials/header') %>

<main>
  <div class="section-header">
    <h2><%= title %></h2>
    <p>
      Browse our service project categories to find opportunities that match
      your interests.
    </p>
  </div>
  <ul>
    <% categories.forEach(category => { %>
      <li class="card">
        <h3><%= category.name %></h3>
      </li>
    <% }); %>
  </ul>
</main>

<%- include('partials/footer') %>