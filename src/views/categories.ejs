<%- include('partials/header') %>

<main>
  <div class="container">
    <div class="section-header">
      <h2><%= title %></h2>
      <p>
        Browse our service project categories to find opportunities that match
        your interests.
      </p>
    </div>
    <ul>
      <% categories.forEach(category => { %>
        <li class="card">
          <h3><a href="/category/<%= category.category_id %>"><%= category.name %></a></h3>
        </li>
      <% }); %>
    </ul>
  </div>
</main>

<%- include('partials/footer') %>