<%- include('partials/header') %>
<main>
    <div class="container">
        <h1><%= project.title %></h1>

        <p><%= project.description %></p>
        <p>
            Date:
            <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
        </p>
        <p>Location: <%= project.location %></p>
        <p>
            Organization:
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>

        <section class="project-categories" aria-labelledby="categories-heading">
            <h2 id="categories-heading">Categories</h2>
            <% if (categories.length === 0) { %>
                <p>This project has not been assigned to any categories.</p>
            <% } else { %>
                <ul class="category-tags">
                    <% categories.forEach(category => { %>
                        <li>
                            <a class="category-tag" href="/category/<%= category.category_id %>"><%= category.name %></a>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </section>
        <div class="page-actions">
            <a href="/assign-categories/<%= project.project_id %>" class="btn btn-accent">Edit Categories</a>
        </div>
    </div>
</main>
    </div>
</main>
<%- include('partials/footer') %>